<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  options.xml - 选项对话框皮肤
  ============================================================================
-->
<Window size="600,480" caption="0,0,0,32">
  <Font name="Microsoft YaHei UI" size="9" default="true" />
  <Font name="Microsoft YaHei UI" size="10" bold="true" id="1" />

  <VerticalLayout bkcolor="#FFFFFFFF">
    <HorizontalLayout height="32" bkcolor="#FF2D2D30">
      <Label text="选项" font="1" textColor="#FFFFFFFF" padding="8,8,0,0"/>
      <Control />
      <Button name="btn_close" width="28" height="16" padding="0,8,0,0"
              normalimage="file='icons/close.png'"
              hotimage="file='icons/close_hover.png'"
              pushedimage="file='icons/close_pushed.png'"/>
    </HorizontalLayout>

    <VerticalLayout inset="12,12,12,12">
      <!-- 选项卡 -->
      <TabLayout name="tabs" height="28">
        <Button name="tab_general" text="常规" width="80" height="28" selected="true"/>
        <Button name="tab_archive" text="压缩" width="80" height="28"/>
        <Button name="tab_extract" text="解压" width="80" height="28"/>
        <Button name="tab_integration" text="集成" width="80" height="28"/>
        <Button name="tab_advanced" text="高级" width="80" height="28"/>
      </TabLayout>
      <Control height="8" />

      <!-- 常规 -->
      <VerticalLayout name="page_general">
        <HorizontalLayout height="28">
          <Label text="默认解压目录：" width="100" height="22" padding="0,2,0,0"/>
          <Edit name="edit_default_extract" height="22"/>
          <Button name="btn_browse_extract" text="..." width="30" height="22"/>
        </HorizontalLayout>
        <Control height="8" />
        <HorizontalLayout height="28">
          <Label text="默认压缩目录：" width="100" height="22" padding="0,2,0,0"/>
          <Edit name="edit_default_compress" height="22"/>
          <Button name="btn_browse_compress" text="..." width="30" height="22"/>
        </HorizontalLayout>
        <Control height="8" />
        <Check name="chk_open_after" text="解压后打开目标文件夹" height="20" selected="true"/>
        <Check name="chk_delete_after" text="解压后删除压缩包" height="20"/>
        <Check name="chk_show_password" text="显示密码输入框" height="20" selected="true"/>
        <Check name="chk_single_instance" text="只允许一个实例" height="20" selected="true"/>
      </VerticalLayout>

      <!-- 压缩 -->
      <VerticalLayout name="page_archive" visible="false">
        <HorizontalLayout height="28">
          <Label text="默认格式：" width="100" height="22" padding="0,2,0,0"/>
          <Combo name="combo_default_format" height="22" width="120">
            <ListHeaderItem text="ZIP" />
            <ListHeaderItem text="7Z" />
            <ListHeaderItem text="TAR" />
          </Combo>
        </HorizontalLayout>
        <Control height="8" />
        <HorizontalLayout height="28">
          <Label text="默认压缩级别：" width="100" height="22" padding="0,2,0,0"/>
          <Combo name="combo_default_level" height="22" width="120">
            <ListHeaderItem text="仅存储" />
            <ListHeaderItem text="最快" />
            <ListHeaderItem text="快速" />
            <ListHeaderItem text="标准" selected="true"/>
            <ListHeaderItem text="最大" />
            <ListHeaderItem text="极限" />
          </Combo>
        </HorizontalLayout>
        <Control height="8" />
        <Check name="chk_default_solid" text="默认使用固实压缩（7Z）" height="20"/>
        <Check name="chk_default_aes" text="默认使用 AES-256 加密" height="20"/>
      </VerticalLayout>

      <!-- 解压 -->
      <VerticalLayout name="page_extract" visible="false">
        <Check name="chk_overwrite" text="覆盖已存在的文件" height="20"/>
        <Check name="chk_keep_broken" text="保留损坏的文件" height="20"/>
        <Check name="chk_skip_crc" text="跳过 CRC 校验" height="20"/>
        <Check name="chk_extract_to_subdir" text="解压到以压缩包命名的子目录" height="20" selected="true"/>
        <Check name="chk_remove_duplicate" text="去除重复的顶层目录" height="20"/>
      </VerticalLayout>

      <!-- 集成 -->
      <VerticalLayout name="page_integration" visible="false">
        <Check name="chk_shell_menu" text="集成到资源管理器右键菜单" height="20" selected="true"/>
        <Check name="chk_associate" text="关联压缩文件类型" height="20" selected="true"/>
        <Check name="chk_show_icon" text="在压缩文件上显示自定义图标" height="20" selected="true"/>
        <Control height="8" />
        <Label text="关联的文件类型：" height="20"/>
        <VerticalLayout height="180" inset="0,4,0,0" bkcolor="#FFF8F8F8" bordercolor="#FFCCCCCC" bordersize="1">
          <Check name="assoc_zip" text="ZIP (.zip, .zipx)" height="20" selected="true"/>
          <Check name="assoc_7z" text="7Z (.7z)" height="20" selected="true"/>
          <Check name="assoc_rar" text="RAR (.rar)" height="20" selected="true"/>
          <Check name="assoc_tar" text="TAR (.tar)" height="20" selected="true"/>
          <Check name="assoc_gz" text="GZIP (.gz, .gzip)" height="20" selected="true"/>
          <Check name="assoc_bz2" text="BZIP2 (.bz2)" height="20" selected="true"/>
          <Check name="assoc_xz" text="XZ (.xz)" height="20" selected="true"/>
          <Check name="assoc_zst" text="ZSTD (.zst, .zstd)" height="20" selected="true"/>
          <Check name="assoc_lz4" text="LZ4 (.lz4)" height="20" selected="true"/>
          <Check name="assoc_cab" text="CAB (.cab)" height="20" selected="true"/>
        </VerticalLayout>
      </VerticalLayout>

      <!-- 高级 -->
      <VerticalLayout name="page_advanced" visible="false">
        <HorizontalLayout height="28">
          <Label text="线程数：" width="100" height="22" padding="0,2,0,0"/>
          <Combo name="combo_threads" height="22" width="120">
            <ListHeaderItem text="自动" selected="true"/>
            <ListHeaderItem text="1" />
            <ListHeaderItem text="2" />
            <ListHeaderItem text="4" />
            <ListHeaderItem text="8" />
          </Combo>
        </HorizontalLayout>
        <Control height="8" />
        <HorizontalLayout height="28">
          <Label text="内存使用上限：" width="100" height="22" padding="0,2,0,0"/>
          <Edit name="edit_mem_limit" height="22" text="0"/>
          <Label text="MB (0=无限制)" width="120" height="22" padding="4,2,0,0"/>
        </HorizontalLayout>
        <Control height="8" />
        <Check name="chk_logging" text="启用日志" height="20" selected="true"/>
        <Check name="chk_check_update" text="启动时检查更新" height="20"/>
        <Check name="chk_send_stats" text="发送匿名使用统计" height="20"/>
      </VerticalLayout>

      <Control />
      <HorizontalLayout height="32" inset="0,4,0,0">
        <Control />
        <Button name="btn_ok" text="确定" width="80" height="28"/>
        <Control width="8" />
        <Button name="btn_cancel" text="取消" width="80" height="28"/>
        <Control width="8" />
        <Button name="btn_apply" text="应用" width="80" height="28"/>
      </HorizontalLayout>
    </VerticalLayout>
  </VerticalLayout>
</Window>
