<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  about.xml - 关于对话框皮肤
  ============================================================================
-->
<Window size="440,360" caption="0,0,0,32">
  <Font name="Microsoft YaHei UI" size="9" default="true" />
  <Font name="Microsoft YaHei UI" size="10" bold="true" id="1" />
  <Font name="Microsoft YaHei UI" size="14" bold="true" id="2" />

  <VerticalLayout bkcolor="#FFFFFFFF">
    <HorizontalLayout height="32" bkcolor="#FF2D2D30">
      <Label text="关于 BandzipClone" font="1" textColor="#FFFFFFFF" padding="8,8,0,0"/>
      <Control />
      <Button name="btn_close" width="28" height="16" padding="0,8,0,0"
              normalimage="file='icons/close.png'"
              hotimage="file='icons/close_hover.png'"
              pushedimage="file='icons/close_pushed.png'"/>
    </HorizontalLayout>

    <VerticalLayout inset="24,24,24,24">
      <!-- 图标 -->
      <HorizontalLayout height="64">
        <Control width="64" height="64">
          <Button name="btn_icon" width="48" height="48" padding="8,8,8,8"
                  normalimage="file='icons/app.png'"/>
        </Control>
        <VerticalLayout inset="8,0,0,0">
          <Label text="BandzipClone" font="2" height="24"/>
          <Label name="lbl_version" text="版本 0.9.0" height="20" textcolor="#FF666666"/>
        </VerticalLayout>
      </HorizontalLayout>
      <Control height="16" />

      <Label text="类 Bandizip 的开源解压缩软件" height="20"/>
      <Control height="4" />
      <Label text="支持 ZIP / 7Z / RAR / TAR / GZ / BZ2 / XZ / ZSTD / LZ4 / CAB" height="20" textcolor="#FF666666"/>
      <Control height="16" />

      <Label text="许可证：GNU Affero General Public License v3" height="20"/>
      <Control height="4" />
      <Label text="Copyright (C) 2024 BandzipClone Contributors" height="20" textcolor="#FF666666"/>
      <Control height="16" />

      <HorizontalLayout height="20">
        <Label text="主页：" width="50" textcolor="#FF666666"/>
        <Link name="link_homepage" text="https://github.com/bandzipclone/bandzipclone"
              textcolor="#FF0078D4" hovertextcolor="#FF005499"/>
      </HorizontalLayout>
      <Control />

      <HorizontalLayout height="32" inset="0,4,0,0">
        <Control />
        <Button name="btn_ok" text="确定" width="80" height="28"/>
      </HorizontalLayout>
    </VerticalLayout>
  </VerticalLayout>
</Window>
